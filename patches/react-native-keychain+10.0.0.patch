+package com.oblador.keychain
+
+import android.content.pm.ApplicationInfo
+
+/**
+ * DOGTRACKER_KEYCHAIN_LOG (DogTracker patch): the library's android.util.Log
+ * calls come here (every file imports this object as `Log`). They print only
+ * in a debuggable app: upstream logs every missing entry with its service name
+ * ("No entry found for service: …", the Supabase project ref) and exception
+ * messages on every read, also in release builds.
+ */
+object KeychainLog {
+  @Volatile var enabled = false
+
+  fun init(info: ApplicationInfo?) {
+    enabled = info != null && (info.flags and ApplicationInfo.FLAG_DEBUGGABLE) != 0
+  }
+
+  fun d(tag: String?, msg: String?, tr: Throwable? = null): Int =
+    if (enabled) android.util.Log.d(tag, msg ?: "", tr) else 0
+  fun i(tag: String?, msg: String?, tr: Throwable? = null): Int =
+    if (enabled) android.util.Log.i(tag, msg ?: "", tr) else 0
+  fun w(tag: String?, msg: String?, tr: Throwable? = null): Int =
+    if (enabled) android.util.Log.w(tag, msg ?: "", tr) else 0
+  fun e(tag: String?, msg: String?, tr: Throwable? = null): Int =
+    if (enabled) android.util.Log.e(tag, msg ?: "", tr) else 0
+}
