<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets scripts/fixture-screenshots.sh open named screen
     states (src/dev/ScreenFixtures.js). Release builds have no such scheme. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <application>
    <activity android:name=".MainActivity" tools:node="merge">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="dogtracker" android:host="dev" />
      </intent-filter>
    </activity>
  </application>
</manifest>
