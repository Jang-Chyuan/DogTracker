    </target>
    <target android:name="tail">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="380" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="tail_mark_upper">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="520" android:duration="50" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="tail_mark_lower">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="570" android:duration="50" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="eye_left">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:startOffset="300" android:duration="120" />
        </aapt:attr>
    </target>
    <target android:name="eye_right">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:startOffset="300" android:duration="120" />
        </aapt:attr>
    </target>
    <target android:name="nose">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:startOffset="360" android:duration="100" />
        </aapt:attr>
    </target>
    <target android:name="tail_group">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="10"
                    android:startOffset="620" android:duration="60" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="10" android:valueTo="-6"
                    android:duration="70" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="-6" android:valueTo="0"
                    android:duration="50" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
