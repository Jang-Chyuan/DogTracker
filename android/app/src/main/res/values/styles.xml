<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Confirmation dialogs (Alert.alert), design v3 確認對話框: white,
             24dp corners, dark text, coral-red (tonalText) buttons. -->
        <item name="alertDialogTheme">@style/AppAlertDialog</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog</item>
    </style>

    <style name="AppAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="colorAccent">#A3413A</item>
        <item name="android:textColorPrimary">#222222</item>
        <item name="android:textColorSecondary">#5E5E5E</item>
    </style>

    <!-- Launch theme for MainActivity; installSplashScreen() swaps to AppTheme.
         Before Android 12 the compat library shows the static drawing. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
